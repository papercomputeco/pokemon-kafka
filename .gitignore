# ROM files (legally obtained, not for distribution) — keep the dir, never its contents
rom/*
!rom/.gitkeep

# Generated agent run data (frames, events, summaries)
runs/

# Emulator save data
*.ram
*.sav
*.state

# Screenshot output
frames/

# Observer memory output (per-run observations + watermark)
pokedex/memory/

# Plans (ephemeral working artifacts, never commit)
docs/plans/
docs/superpowers/

# Agent working memory (ephemeral per-run notes)
notes.md

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/

# Environment / secrets
.env
*.key
api-key-*.txt

# Config (may contain credential env var references)
config.toml

# Claude Code (user-specific)
.claude/

# Git worktrees
.worktrees/

# Test artifacts
.coverage
.pytest_cache/

# Pokedex session logs: log1-6 are committed as examples, everything
# else is local-only run output (users do their own training runs).
pokedex/log*.md
!pokedex/log1.md
!pokedex/log2.md
!pokedex/log3.md
!pokedex/log4.md
!pokedex/log5.md
!pokedex/log6.md

# Generated results
pokedex/evolve_results.json

# Run output. Everything under data/ is generated by a run — relay lanes, eval fitness, advisor
# proposals, local_runs evidence, the game-event log (data/game/*.jsonl grows to GBs). Only the
# telemetry .gitkeep is tracked. 2026-08-16: a `git add -A` swept 183 files incl. a 3 GB log into a
# commit; GitHub's 100 MB hook rejected the push. Ignore the whole tree and re-include the keep.
data/*
!data/telemetry/
data/telemetry/*
!data/telemetry/.gitkeep

# DuckDB warehouse files
data/*.duckdb
data/*.duckdb.wal

# dlt pipeline state
.dlt/

# Docker
docker-compose.override.yml

# Committed replayable demo runs (frames + events), but NOT the generated states.
# The bare `frames/` rule above matches at any depth, so re-include demo-runs first.
!demo-runs/
!demo-runs/**
demo-runs/states/
benchmarks/artifact/local-vs-haiku.html
